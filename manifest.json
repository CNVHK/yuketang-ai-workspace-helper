{
  "manifest_version": 3,
  "name": "星空雨课堂助手",
  "version": "1.0.4",
  "description": "长江雨课堂 / 学堂在线（ai-workspace 学习空间）增强助手：视频播完自动跳下一个、防切屏暂停、自动二倍速。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.yuketang.cn/*",
        "*://*.xuetangx.com/*",
        "*://*.gdufemooc.cn/*"
      ],
      "js": [
        "anti-switch.js",
        "force-speed.js",
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.yuketang.cn/*",
        "*://*.xuetangx.com/*",
        "*://*.gdufemooc.cn/*"
      ],
      "js": [
        "auto-next.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
